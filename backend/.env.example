APP_NAME=LedgerLine API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_PASSWORD=replace-with-a-local-password
APP_DB_PASSWORD=replace-with-a-different-local-app-password
DATABASE_URL=postgresql+psycopg://ledgerline_app:replace-with-a-different-local-app-password@127.0.0.1:5433/ledgerline
MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerline_user:replace-with-a-local-password@127.0.0.1:5433/ledgerline
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_WITH_PYTHON_SECRETS
JWT_ACCESS_TOKEN_MINUTES=30
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
OTP_HMAC_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
OTP_MAILER_URL=https://script.google.com/macros/s/your-deployment-id/exec
OTP_MAILER_SECRET=replace-with-a-shared-secret
