digraph LedgerLineArchitecture {
  graph [
    rankdir=TB, bgcolor="#F7F9FC", pad="0.32", nodesep="0.42", ranksep="0.62",
    splines=ortho, compound=true, newrank=true,
    fontname="Inter", fontsize=24, labelloc=t, labeljust=l,
    label=<<B>LEDGERLINE</B>  <FONT POINT-SIZE="15" COLOR="#64748B">SYSTEM ARCHITECTURE</FONT><BR/><FONT POINT-SIZE="10" COLOR="#64748B">React client • FastAPI services • double-entry PostgreSQL ledger • OTP via Apps Script + Gmail</FONT>>
  ];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=10, margin="0.16,0.10", color="#CBD5E1", penwidth=1.15, fillcolor="#FFFFFF", fontcolor="#172033"];
  edge [fontname="Inter", fontsize=9, color="#64748B", fontcolor="#475569", penwidth=1.3, arrowsize=0.75];

  subgraph cluster_client {
    label=<<B>CLIENT EXPERIENCE</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">User-controlled browser</FONT>>;
    color="#CBD5E1"; fillcolor="#F1F5F9"; style="rounded,filled"; penwidth=1.2; margin=18;
    users [label=<<B>End users</B><BR/><FONT POINT-SIZE="9">Admin • Account holder • Auditor</FONT>>, color="#94A3B8"];
    spa [label=<<B>React + TypeScript SPA</B><BR/><FONT POINT-SIZE="9">Vite • Tailwind • role-aware navigation</FONT><BR/><FONT POINT-SIZE="9">Dashboard • Accounts • Transfers • Statements • Audit</FONT>>, fillcolor="#EAF2FF", color="#5B8DEF", penwidth=1.5];
    session [label=<<B>Browser session</B><BR/><FONT POINT-SIZE="9">LedgerLine bearer JWT in memory</FONT><BR/><FONT POINT-SIZE="9">HTTPS / JSON API requests</FONT>>, color="#94A3B8"];
    users -> spa [label="uses"];
    spa -> session [label="authenticated session"];
  }

  subgraph cluster_render {
    label=<<B>RENDER HOSTING</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">Owner-confirmed Render Free • deploy trigger not verified</FONT>>;
    color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled"; penwidth=1.5; margin=18;
    static [label=<<B>Render Static Site</B><BR/><FONT POINT-SIZE="9">ledgerline-frontend-bmtt.onrender.com</FONT><BR/><FONT POINT-SIZE="9">Serves compiled SPA assets</FONT>>, fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.5];
    subgraph cluster_api {
      label=<<B>FastAPI Web Service</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">ledgerline-api-9dld.onrender.com • Python 3.11</FONT>>;
      color="#60A5FA"; fillcolor="#F8FBFF"; style="rounded,filled"; penwidth=1.2; margin=14;
      routes [label=<<B>REST API routers</B><BR/><FONT POINT-SIZE="9">Auth • Accounts • Transactions</FONT><BR/><FONT POINT-SIZE="9">Statements • Audit • Health</FONT>>, color="#60A5FA"];
      security [label=<<B>Validation &amp; security boundary</B><BR/><FONT POINT-SIZE="9">Pydantic • JWT • role / ownership checks</FONT><BR/><FONT POINT-SIZE="9">Google ID-token verification</FONT>>, fillcolor="#E0F2FE", color="#0284C7"];
      services [label=<<B>Application services</B><BR/><FONT POINT-SIZE="9">Auth + OTP • Accounts • Transaction engine</FONT><BR/><FONT POINT-SIZE="9">Idempotency • Audit</FONT>>, color="#60A5FA"];
      orm [label=<<B>SQLAlchemy 2 + psycopg 3</B><BR/><FONT POINT-SIZE="9">Session and transaction boundaries</FONT>>, color="#94A3B8"];
      routes -> security -> services -> orm;
    }
    static -> spa [label="serves SPA", style=dashed, color="#2563EB", fontcolor="#1D4ED8", constraint=false];
    static -> routes [label="HTTPS REST API", color="#2563EB", fontcolor="#1D4ED8", penwidth=1.8];
  }

  subgraph cluster_identity {
    label=<<B>IDENTITY PROVIDER</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">Google sign-in</FONT>>;
    color="#C4B5FD"; fillcolor="#F5F3FF"; style="rounded,filled"; penwidth=1.2; margin=14;
    google [label=<<B>Google Identity Services</B><BR/><FONT POINT-SIZE="9">OAuth / OpenID Connect</FONT><BR/><FONT POINT-SIZE="9">Issues Google ID token</FONT>>, color="#8B5CF6"];
  }

  subgraph cluster_mail {
    label=<<B>OTP EMAIL DELIVERY</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">Shared-secret-protected HTTPS integration</FONT>>;
    color="#F9A8D4"; fillcolor="#FDF2F8"; style="rounded,filled"; penwidth=1.2; margin=14;
    script [label=<<B>Google Apps Script Web App</B><BR/><FONT POINT-SIZE="9">/exec endpoint • expected secret / email / code JSON contract</FONT><BR/><FONT POINT-SIZE="9">External script source not independently reviewed</FONT>>, fillcolor="#FCE7F3", color="#DB2777"];
    mailapp [label=<<B>Gmail MailApp</B><BR/><FONT POINT-SIZE="9">Sends LedgerLine verification email</FONT><BR/><FONT POINT-SIZE="9">Subject to Google account quotas</FONT>>, color="#DB2777"];
    inbox [label=<<B>Recipient mailbox</B><BR/><FONT POINT-SIZE="9">User receives OTP</FONT>>, color="#DB2777"];
    script -> mailapp [label="authorized send"];
    mailapp -> inbox [label="email delivery"];
  }

  subgraph cluster_data {
    label=<<B>DATA &amp; INTEGRITY</B><BR/><FONT POINT-SIZE="9" COLOR="#64748B">Neon-managed PostgreSQL</FONT>>;
    color="#86EFAC"; fillcolor="#F0FDF4"; style="rounded,filled"; penwidth=1.4; margin=18;
    db [shape=cylinder, label=<<B>Neon PostgreSQL</B><BR/><FONT POINT-SIZE="9">Production database • owner-confirmed</FONT><BR/><FONT POINT-SIZE="9">Database name / branch not independently verified</FONT>>, fillcolor="#DCFCE7", color="#16A34A", penwidth=1.6];
    records [label=<<B>Application records</B><BR/><FONT POINT-SIZE="9">Users • Google identities • OTP challenges</FONT><BR/><FONT POINT-SIZE="9">Customer accounts • Ledger accounts</FONT><BR/><FONT POINT-SIZE="9">Journal transactions • Ledger entries</FONT><BR/><FONT POINT-SIZE="9">Idempotency records • Audit events</FONT>>, color="#22C55E"];
    controls [label=<<B>Database integrity controls</B><BR/><FONT POINT-SIZE="9">Constraints • triggers • row locks</FONT><BR/><FONT POINT-SIZE="9">Restricted runtime role • protected posted journal</FONT>>, fillcolor="#ECFDF5", color="#16A34A"];
    db -> records [dir=both, arrowhead=none, arrowtail=none, style=dashed, color="#16A34A"];
    records -> controls [style=dashed, arrowhead=none, color="#16A34A"];
  }

  migrations [label=<<B>Controlled Alembic migration path</B><BR/><FONT POINT-SIZE="9">Privileged migration connection</FONT><BR/><FONT POINT-SIZE="9">Separate from API runtime role</FONT>>, fillcolor="#FFF7ED", color="#F97316", penwidth=1.4];
  boundary [shape=note, label=<<B>Product boundary</B><BR/><FONT POINT-SIZE="9">Internal ledger demonstration only.</FONT><BR/><FONT POINT-SIZE="9">No bank / UPI / card / NEFT / RTGS settlement.</FONT><BR/><FONT POINT-SIZE="9">Demo deposits are not externally funded.</FONT>>, fillcolor="#FFFBEB", color="#F59E0B", fontcolor="#78350F"];

  session -> routes [label="Bearer JWT", color="#2563EB", fontcolor="#1D4ED8", minlen=1];
  google -> spa [label="Google ID token", color="#7C3AED", fontcolor="#6D28D9", constraint=false];
  security -> google [label="Validate issuer / audience / claims", style=dashed, color="#7C3AED", fontcolor="#6D28D9", constraint=false];
  services -> script [label="HTTPS POST: email + OTP + shared secret", color="#BE185D", fontcolor="#9D174D", penwidth=1.6, minlen=2];
  inbox -> spa [label="User enters OTP", style=dashed, color="#BE185D", fontcolor="#9D174D", constraint=false];
  orm -> db [label="restricted DATABASE_URL", color="#15803D", fontcolor="#166534", penwidth=1.7, minlen=2];
  migrations -> db [label="schema upgrades", style=dashed, color="#EA580C", fontcolor="#C2410C"];
  controls -> boundary [style=invis];
}
